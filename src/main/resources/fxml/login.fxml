<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.effect.DropShadow?>

<AnchorPane prefHeight="450.0" prefWidth="700.0" style="-fx-background-color: #E0F7FA;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.school.elearning.controllers.LoginController">
    <children>
        <VBox alignment="CENTER" layoutX="175.0" layoutY="50.0" prefHeight="350.0" prefWidth="350.0" spacing="20.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #0D47A1; -fx-border-width: 2; -fx-border-radius: 10;">
            <effect>
                <DropShadow>
                    <color>
                        <Color red="0.05" green="0.18" blue="0.40" opacity="0.5"/>
                    </color>
                </DropShadow>
            </effect>
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <Label text="Student Login" textFill="#0D47A1">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                <TextField fx:id="usernameField" promptText="Username" style="-fx-border-color: #B0BEC5; -fx-border-radius: 5; -fx-prompt-text-fill: #78909C;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </TextField>
                <PasswordField fx:id="passwordField" promptText="Password" style="-fx-border-color: #B0BEC5; -fx-border-radius: 5; -fx-prompt-text-fill: #78909C;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </PasswordField>
                <Button fx:id="loginButton" onAction="#handleLoginButtonAction" prefHeight="40.0" prefWidth="300.0" style="-fx-background-color: #D32F2F; -fx-background-radius: 5;" text="Login" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Button>
                <Button fx:id="registerButton" onAction="#handleRegisterButtonAction" prefHeight="40.0" prefWidth="300.0" style="-fx-background-color: #1976D2; -fx-background-radius: 5;" text="Create Account" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Button>
                <Label fx:id="messageLabel" textFill="#D32F2F" />
            </children>
        </VBox>
    </children>
</AnchorPane> 