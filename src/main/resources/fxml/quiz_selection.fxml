<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="quizSelectionRoot" alignment="TOP_CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.school.elearning.controllers.QuizSelectionController" prefHeight="500.0" prefWidth="650.0" style="-fx-background-color: #F4F6F8;">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>
    <children>
        <Label text="Select a Quiz to Begin" textFill="#0D47A1">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>
        <TableView fx:id="quizzesTableView" prefHeight="350.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="titleColumn" prefWidth="300.0" text="Quiz Title" />
                <TableColumn fx:id="difficultyColumn" prefWidth="150.0" text="Difficulty" />
                <TableColumn fx:id="timeLimitColumn" prefWidth="120.0" text="Time (Mins)" />
                <TableColumn fx:id="questionsCountColumn" prefWidth="100.0" text="Questions" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <Button fx:id="startQuizButton" onAction="#handleStartSelectedQuizAction" text="Start Selected Quiz" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" prefHeight="40.0" prefWidth="200.0" disable="true">
            <font>
                <Font size="16.0" />
            </font>
        </Button>
        <Label fx:id="statusLabel" textFill="red" />
    </children>
</VBox> 