<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17"
      fx:controller="com.school.elearning.controllers.ProgressViewController"
      prefHeight="500.0" prefWidth="680.0" style="-fx-background-color: #FFFFFF; -fx-padding: 20;">
    <children>
        <Label text="My Quiz Progress">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <Label fx:id="summaryLabel" text="Summary of your performance will appear here.">
            <font>
                <Font name="System Regular" size="14.0" />
            </font>
        </Label>
        <TableView fx:id="progressTableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="quizTitleColumn" text="Quiz Title" prefWidth="200.0"/>
                <TableColumn fx:id="scoreColumn" text="Score (%)" prefWidth="100.0" style="-fx-alignment: CENTER_RIGHT;"/>
                <TableColumn fx:id="timeTakenColumn" text="Time Taken" prefWidth="120.0" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="dateColumn" text="Date Attempted" prefWidth="150.0" style="-fx-alignment: CENTER;"/>
            </columns>
            <placeholder>
                <Label text="No quiz attempts found."/>
            </placeholder>
        </TableView>
        <Label fx:id="noAttemptsLabel" text="You have not attempted any quizzes yet." visible="false" managed="false">
             <font><Font name="System Regular" size="16.0" /></font>
        </Label>
    </children>
</VBox> 