<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="subjectSelectionRoot" spacing="15.0" alignment="TOP_CENTER" 
      xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17" 
      fx:controller="com.school.elearning.controllers.SubjectSelectionController"
      style="-fx-padding: 20; -fx-background-color: #F5F5F5;">
    <children>
        <Label text="Select a Subject">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
                <TilePane fx:id="subjectTilePane" hgap="15" vgap="15" 
                  alignment="CENTER" style="-fx-padding: 10;" VBox.vgrow="ALWAYS">
                    <!-- Subject cards/buttons will be populated here by the controller -->
                </TilePane>
        <Label fx:id="statusLabel" text="" textFill="RED"/>
    </children>
</VBox> 