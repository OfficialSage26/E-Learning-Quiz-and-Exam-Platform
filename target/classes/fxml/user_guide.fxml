<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17"
            fx:controller="com.school.elearning.controllers.UserGuideController"
            prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #FFFFFF;">
    <children>
        <ScrollPane fitToWidth="true" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <content>
                <VBox spacing="15.0" style="-fx-padding: 20;">
                    <Label text="User Guide / Tutorial" >
                        <font>
                            <Font name="System Bold" size="24.0" />
                        </font>
                    </Label>
                    
                    <Label text="Getting Started" >
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                        <padding><Insets top="10"/></padding>
                    </Label>
                    <Text text="1. Registration and Login:
- Create a new account using the registration form
- Use your username and password to log in
- Your progress will be saved automatically
2. Dashboard Navigation:
- Start New Quiz: Begin a new quiz session
- View My Progress: Check your performance history
- View Leaderboards: See how you rank among other students
- User Guide: Access this help section anytime"
                          wrappingWidth="720.0">
                        <font>
                            <Font name="System Regular" size="14.0" />
                        </font>
                    </Text>

                    <Label text="Taking Quizzes" >
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                        <padding><Insets top="10"/></padding>
                    </Label>
                    <Text text="1. Quiz Selection:
- Choose a subject from the available options
- Select difficulty level (Easy, Medium, Hard)
- Note: Medium and Hard levels require achieving minimum scores in previous levels

2. During the Quiz:
- Questions are randomized for each attempt
- Multiple choice and short answer questions available
- Use navigation buttons or question numbers to move between questions
- Mark questions for review to revisit them later
- Timer shows remaining time (auto-submits when time runs out)
- Warning messages appear at 10, 5, and 1 minute remaining

3. Answering Questions:
- Multiple Choice: Select one option
- True/False: Choose true or false
- Short Answer: Type your response
- All answers are saved automatically

4. Review and Submission:
- Use 'Review All' to check all questions before submitting
- Submit when ready or when time runs out
- Get immediate feedback on your performance"
                          wrappingWidth="720.0">
                        <font>
                            <Font name="System Regular" size="14.0" />
                        </font>
                    </Text>

                    <Label text="Progress and Performance" >
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                        <padding><Insets top="10"/></padding>
                    </Label>
                    <Text text="1. Progress Tracking:
- View your quiz history
- See scores for each attempt
- Track time taken per quiz
- Monitor improvement over time

2. Leaderboards:
- Compare your performance with other students
- Filter by subject and difficulty
- See top performers in each category

3. Performance Feedback:
- Immediate scoring after quiz completion
- Color-coded results (Red: &lt;50%, Orange: &lt;75%, Green: ≥75%)
- Detailed feedback for each question
- Time taken analysis"
                          wrappingWidth="720.0">
                        <font>
                            <Font name="System Regular" size="14.0" />
                        </font>
                    </Text>

                    <Label text="Tips for Success" >
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                        <padding><Insets top="10"/></padding>
                    </Label>
                    <Text text="1. Time Management:
- Keep an eye on the timer
- Don't spend too long on any single question
- Use the review feature for difficult questions

2. Answer Strategy:
- Read questions carefully
- Review your answers before submitting
- Use the mark for review feature for uncertain answers

3. Progress Improvement:
- Start with Easy difficulty to build confidence
- Aim for higher scores to unlock advanced levels
- Review your performance to identify areas for improvement"
                          wrappingWidth="720.0">
                        <font>
                            <Font name="System Regular" size="14.0" />
                        </font>
                    </Text>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane> 